body {
  font-family: var(--base-font-family, 'System stack', sans-serif);
}

h1, h2 {
  font-wuight: 700;
}

h3 {
  font-weight: 600;
  font-size: 18px;
}

.prev,
.next {
  font-size: 20px;
  font-weight: 700;
  a {
    font-size: 20px;
    font-weight: 700;
  }
}

.search-box {
  order: 1;
  margin-right: 0;
  margin-left: 1rem;

  .suggestions {
    left: auto !important;
    right: 0 !important;
  }
}

.sidebar-group.is-sub-group > .sidebar-heading:not(.clickable){
  opacity: 1 !important;
  font-size: 15.2px;
  cursor: pointer !important;
}

.version-table {
  display:flex;
  flex-wrap: wrap;

  table {
    margin-right: 30px;

    th, td {
      width:180px;
    }

    tr {
      border: none;
    }

    tbody {
      display: flex;
      flex-direction: column;
      height: 300px;
      overflow: auto;
    }
  }
}

.theme-switcher {
  display: flex;
  align-items: center;
  margin-left: 16px;
  line-height: 0;

  .dropdown {
    position: relative;

    &-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--color-fill-surface, #ffffff);
      border-radius: 4px;
      min-width: 80px;
      min-height: 32px;
      font-size: 14px;
      font-weight: 400;
      color: var(--color-text-primary, #12344d);
      border: 2px solid transparent;
      box-sizing: border-box;
      cursor: pointer;
      padding: 0 8px;

      .arrow {
        margin: 2px 0 0 4px;
      }
    }

    &-label {
      padding-right: 6px;
    }

    &-options {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-fill-surface, #ffffff);
      border: 1px solid var(--color-boundary-border-mildest, #e1e4e8);
      border-radius: 4px;
      z-index: 1000;
      margin-top: 4px;
      line-height: 28px;
    }

    &-option {
      padding: 2px 8px;
      cursor: pointer;
      color: var(--color-text-primary, #12344d);
      font-size: 14px;

      &:hover {
        background: var(--color-fill-container, #f6f7f8);
      }
    }
  }
}

// Apply theme variables to VuePress elements
.dew-light-theme,
.dew-dark-theme {
  h1, h2, h3, h4, p, table, li, .last-updated .time {
    color: var(--color-text-primary);
  }

  h2 {
    border-bottom: 1px solid var(--color-boundary-border-mildest);
  }

  .dropdown-wrapper .nav-dropdown, tr {
    background-color: var(--color-fill-surface);
  }

  table, th, td, hr, .page-nav .inner, .dropdown-wrapper .nav-dropdown {
    border-color: var(--color-boundary-border-mildest);
  }

  .navbar {
    background-color: var(--color-fill-surface);
    border-bottom-color: var(--color-boundary-border-mildest);

    .links {
      background-color: var(--color-fill-surface);
    }

    .site-name, .nav-links a, span {
      color: var(--color-text-primary);
    }
  }

  .page {
    background-color: var(--color-fill-surface);
  }

  .sidebar {
    background-color: var(--color-fill-surface);
    border-right-color: var(--color-boundary-border-mildest);
  }
  
  .content {
    background-color: var(--color-fill-surface);
    color: var(--color-text-primary);
  }
  
  .search-box input {
    background-color: var(--color-fill-container);
    border-color: var(--color-boundary-border-mildest);
    color: var(--color-text-primary);
  }
  
  code {
    background-color: var(--color-fill-container);
    color: var(--color-text-primary);
  }
  
  pre {
    background-color: var(--color-fill-container); 
    border-color: var(--color-boundary-border-mildest);
  }

  a.sidebar-link, {
    color: var(--color-text-primary);

    &.active, &:hover {
      color: var(--color-text-brand);
    }
  }

  .prev, .next, .next a, li a {
    color: var(--color-text-brand);
  }
}